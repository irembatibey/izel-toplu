# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Formspree form endpoint ID.
# This is a PUBLIC IDENTIFIER, not a secret — it only allows
# submitting to this specific form, the same as a visible
# <form action> URL would. Safe to prefix with NEXT_PUBLIC_.
# Not yet obtained — leave empty until the Formspree account
# is created, per project decision. Do not invent a value here.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# ---
# If a genuine secret (a real API key, a service-role credential,
# anything requiring server-side-only use) is ever needed, it
# must NOT be prefixed with NEXT_PUBLIC_, and this static-export
# architecture cannot safely hold it client-side. That would be
# a signal to revisit the hosting architecture, not to force the
# secret into a client-exposed variable.
